{
    "name": "mywisata/tour-guide-app",
    "description": "Tour Guide Application for Indonesia",
    "type": "project",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^1.10",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse app --level=8",
        "phpcs": "phpcs --standard=PSR12 app",
        "phpcbf": "phpcbf --standard=PSR12 app"
    }
}
