# Tour Guide Application — Environment Configuration Example
# Copy this file to .env and fill in your values
# OR configure directly in app/config/config.php and app/config/database.php

# App Settings
APP_ENV=development
APP_DEBUG=true
APP_NAME="Tour Guide Application"
BASE_URL=http://localhost/wisata/

# Database
DB_HOST=localhost
DB_NAME=tour_guide_app
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Security
# CSRF_TOKEN is auto-generated per session, do not set manually

# Upload
MAX_UPLOAD_SIZE=5242880

# Email (for notifications)
MAIL_FROM=admin@tourguide.app
MAIL_FROM_NAME="Tour Guide App"

# Logging
LOG_PATH=/opt/lampp/htdocs/wisata/logs
