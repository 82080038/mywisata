# MyWisata Application — Environment Configuration Example
# Copy this file to .env and fill in your values
# OR configure directly in app/config/config.php and app/config/database.php
# 
# CATATAN PENTING:
# Untuk konfigurasi lengkap multi-environment (Linux/Windows), 
# gunakan file: prompting/config.json
# File config.json berisi semua konfigurasi untuk development di multiple komputer

# ============================================
# APP SETTINGS
# ============================================
APP_ENV=development
APP_DEBUG=true
APP_NAME="MyWisata Application"
APP_VERSION=1.0.0
BASE_URL=http://localhost/mywisata/
ASSETS_URL=http://localhost/mywisata/public/assets/

# ============================================
# DATABASE SETTINGS
# ============================================
# Main Application Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mywisata
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Address Database (for cascading dropdowns)
DB_ADDRESS_HOST=127.0.0.1
DB_ADDRESS_PORT=3306
DB_ADDRESS_NAME=db_alamat
DB_ADDRESS_USER=root
DB_ADDRESS_PASS=
DB_ADDRESS_CHARSET=utf8mb4
DB_ADDRESS_COLLATION=utf8mb4_unicode_ci

# ============================================
# SECURITY SETTINGS
# ============================================
# CSRF_TOKEN is auto-generated per session, do not set manually
ENCRYPTION_KEY=change-this-encryption-key-in-production-use-32-characters
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=900
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBER=true
PASSWORD_REQUIRE_SPECIAL=true

# ============================================
# FILE UPLOAD SETTINGS
# ============================================
MAX_UPLOAD_SIZE=5242880
UPLOAD_PATH=/opt/lampp/htdocs/mywisata/public/uploads/
UPLOAD_URL=http://localhost/mywisata/public/uploads/

# ============================================
# EMAIL SETTINGS
# ============================================
MAIL_FROM=admin@mywisata.com
MAIL_FROM_NAME="MyWisata App"
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls

# ============================================
# LOGGING SETTINGS
# ============================================
LOG_PATH=/opt/lampp/htdocs/mywisata/logs/
ERROR_LOG_FILE=/opt/lampp/htdocs/mywisata/logs/error.log
AUDIT_LOG_FILE=/opt/lampp/htdocs/mywisata/logs/audit.log

# ============================================
# MAP SETTINGS (OpenStreetMap/Leaflet)
# ============================================
MAP_DEFAULT_LAT=-6.2088
MAP_DEFAULT_LNG=106.8456
MAP_DEFAULT_ZOOM=13
MAP_TILE_LAYER=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# ============================================
# AI CHAT SETTINGS
# ============================================
AI_CHAT_ENABLED=true
AI_CHAT_MODEL=rule-based

# ============================================
# AUDIO GUIDE SETTINGS
# ============================================
AUDIO_GUIDE_ENABLED=true
MAX_AUDIO_SIZE=10485760

# ============================================
# PAYMENT SETTINGS
# ============================================
PAYMENT_GATEWAY=midtrans
PAYMENT_TIMEOUT_HOURS=24

# ============================================
# MIDTRANS PAYMENT GATEWAY
# ============================================
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_MERCHANT_ID=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SANITIZATION=true
MIDTRANS_3DS_SECURE=true

# ============================================
# REDIS CACHING
# ============================================
REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
CACHE_TTL=3600
REDIS_PREFIX=mywisata:

# ============================================
# CDN INTEGRATION
# ============================================
CDN_ENABLED=false
CDN_URL=https://cdn.yourdomain.com
APP_VERSION=1.0.0

# ============================================
# AI CONFIGURATION
# ============================================
# Choose between 'openai' (commercial) or 'ollama' (self-hosted)
USE_SELF_HOSTED_AI=false

# ============================================
# OPENAI INTEGRATION (Commercial)
# ============================================
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=1000
OPENAI_ORGANIZATION=

# ============================================
# OLLAMA INTEGRATION (Self-Hosted)
# ============================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2
OLLAMA_TIMEOUT=60
OLLAMA_SYSTEM_PROMPT=You are a helpful assistant for MyWisata, a tour guide application in Indonesia.

# ============================================
# PROMO CODE SETTINGS
# ============================================
PROMO_ENABLED=true
PROMO_CODE_LENGTH=8
PROMO_DEFAULT_DISCOUNT=10

# ============================================
# CURRENCY SETTINGS
# ============================================
CURRENCY=IDR
CURRENCY_SYMBOL=Rp
CURRENCY_DECIMALS=0

# ============================================
# CURRENCY API (Open Exchange Rates / Fixer)
# ============================================
CURRENCY_API_PROVIDER=openexchangerates
OPENEXCHANGERATES_API_KEY=
FIXER_API_KEY=
CURRENCY_API_CACHE_TTL=3600

# ============================================
# STRIPE PAYMENT GATEWAY
# ============================================
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ============================================
# PAYPAL PAYMENT GATEWAY
# ============================================
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# ============================================
# WHATSAPP BUSINESS API
# ============================================
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v18.0

# ============================================
# DATE/TIME FORMATS
# ============================================
DATE_FORMAT=d-m-Y
TIME_FORMAT=H:i
DATETIME_FORMAT=d-m-Y H:i

# ============================================
# MAINTENANCE MODE
# ============================================
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=Aplikasi sedang dalam pemeliharaan. Silakan cembali lagi nanti.

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ============================================
# PAGINATION
# ============================================
ITEMS_PER_PAGE=20
MAX_ITEMS_PER_PAGE=100

# ============================================
# Multi-Environment Config
# ============================================
# Untuk konfigurasi lengkap yang mendukung Linux & Windows,
# lihat file: prompting/config.json
# 
# File config.json berisi:
# - Environment-specific config (local, staging, production)
# - OS-specific paths (Linux/Windows)
# - Database credentials per environment
# - API keys untuk third-party services
# - System passwords (SUDO, phpMyAdmin)
# - Permissions untuk auto-execution
# - Development preferences
