<?xml version="1.0"?>
<ruleset name="MyWisata Coding Standard">
    <description>PSR-12 coding standard for MyWisata Application</description>
    
    <rule ref="PSR12"/>
    
    <file>app</file>
    
    <exclude-pattern>*/views/*</exclude-pattern>
    <exclude-pattern>*/config/*</exclude-pattern>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    
    <arg name="colors"/>
    <arg value="sp"/>
</ruleset>
